# Re-run configure-module with the restored settings: env file, Traefik
# route, start the container on the restored home volume (profile, database,
# apps and SSH key come with it).

import os
import sys

import agent
import agent.tasks

env = os.environ
if not env.get("TRAEFIK_HOST"):
    # The original instance was backed up before it was ever configured: there
    # is nothing to re-apply, and configure-module requires a host name.
    print(agent.SD_NOTICE + "no host name in the restored settings: configure the module from the UI", file=sys.stderr)
    sys.exit(0)

data = {
    "host": env["TRAEFIK_HOST"],
    "lets_encrypt": env.get("TRAEFIK_LETS_ENCRYPT", "False") == "True",
    "http2https": env.get("TRAEFIK_HTTP2HTTPS", "True") == "True",
    "aiida_user_email": env.get("AIIDA_USER_EMAIL", "aiida@localhost"),
    "aiida_user_first_name": env.get("AIIDA_USER_FIRST_NAME", "AiiDA"),
    "aiida_user_last_name": env.get("AIIDA_USER_LAST_NAME", "User"),
    "aiida_user_institution": env.get("AIIDA_USER_INSTITUTION", ""),
    "default_apps": env.get("DEFAULT_APPS", "").split(),
    "computer_enabled": env.get("COMPUTER_ENABLED") == "true",
    "computer_label": env.get("COMPUTER_LABEL", "gpu-node"),
    "computer_hostname": env.get("COMPUTER_HOSTNAME", ""),
    "computer_username": env.get("COMPUTER_USERNAME", ""),
    "computer_port": int(env.get("COMPUTER_PORT", "22")),
    "computer_workdir": env.get("COMPUTER_WORKDIR", ""),
    "computer_scheduler": env.get("COMPUTER_SCHEDULER", "core.direct"),
    "computer_mpirun": env.get("COMPUTER_MPIRUN", "mpirun -np {tot_num_mpiprocs}"),
    "computer_mpiprocs": int(env.get("COMPUTER_MPIPROCS", "4")),
    "computer_description": env.get("COMPUTER_DESCRIPTION", ""),
}
if "TRAEFIK_LETS_ENCRYPT" not in env:
    # A backup taken with a module version that did not record the setting: say
    # so instead of silently asserting "off". The route is created without a
    # certificate request; enable Let's Encrypt again in the settings.
    data.pop("lets_encrypt", None)
    print(agent.SD_WARNING + "the backup does not tell whether Let's Encrypt was enabled: the route is restored without it", file=sys.stderr)

response = agent.tasks.run(agent_id=env["AGENT_ID"], action="configure-module", data=data)
agent.assert_exp(response["exit_code"] == 0, "The configure-module subtask failed!")
