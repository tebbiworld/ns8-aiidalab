# Persist the settings in state/environment (loaded by aiidalab.service) and
# write the container env file state/aiidalab.env:
#   JUPYTER_TOKEN=""          token auth off, password only
#   NOTEBOOK_ARGS             password hash (sha1:salt:digest, the form of
#                             notebook's passwd_check) + reverse-proxy
#                             settings, appended to the jupyter command by
#                             the image's start-notebook.sh
#   AIIDA_USER_*              identity used when the AiiDA profile is created
#   AIIDALAB_DEFAULT_APPS     apps installed at container start

import hashlib
import json
import os
import random
import sys

import agent

data = json.load(sys.stdin)

agent.set_env("TRAEFIK_HOST", data["host"])
agent.set_env("TRAEFIK_HTTP2HTTPS", data.get("http2https", True))

password = (data.get("password") or "").strip()
password_hash = os.environ.get("PASSWORD_HASH", "")
if password:
    # Same scheme as jupyter_server.auth.security.passwd(algorithm="sha1")
    salt = "%012x" % random.getrandbits(48)
    digest = hashlib.sha1(password.encode("utf-8") + salt.encode("ascii")).hexdigest()
    password_hash = f"sha1:{salt}:{digest}"
    agent.set_env("PASSWORD_HASH", password_hash)

user = {
    "AIIDA_USER_EMAIL": (data.get("aiida_user_email") or "aiida@localhost").strip(),
    "AIIDA_USER_FIRST_NAME": (data.get("aiida_user_first_name") or "AiiDA").strip(),
    "AIIDA_USER_LAST_NAME": (data.get("aiida_user_last_name") or "User").strip(),
    "AIIDA_USER_INSTITUTION": (data.get("aiida_user_institution") or "").strip(),
}
apps = [a.strip() for a in (data.get("default_apps") or []) if a.strip()]
computer_enabled = bool(data.get("computer_enabled", False))
agent.mset_env({
    **user,
    "DEFAULT_APPS": " ".join(apps),
    "COMPUTER_ENABLED": "true" if computer_enabled else "false",
    "COMPUTER_LABEL": (data.get("computer_label") or "gpu-node").strip(),
    "COMPUTER_HOSTNAME": (data.get("computer_hostname") or "").strip(),
    "COMPUTER_USERNAME": (data.get("computer_username") or "").strip(),
    "COMPUTER_PORT": str(int(data.get("computer_port") or 22)),
    "COMPUTER_WORKDIR": (data.get("computer_workdir") or "").strip(),
    "COMPUTER_SCHEDULER": data.get("computer_scheduler") or "core.direct",
    "COMPUTER_MPIRUN": (data.get("computer_mpirun") or "mpirun -np {tot_num_mpiprocs}").strip(),
    "COMPUTER_MPIPROCS": str(int(data.get("computer_mpiprocs") or 4)),
    "COMPUTER_DESCRIPTION": (data.get("computer_description") or "").strip(),
})

# The full-stack image runs the classic notebook server (NotebookApp 6.x);
# the ServerApp/IdentityProvider spellings are added for a future image
# based on jupyter_server 2 — unknown classes are ignored by either server.
notebook_args = " ".join([
    "--NotebookApp.token=''",
    f"--NotebookApp.password='{password_hash}'",
    "--NotebookApp.allow_remote_access=True",
    "--NotebookApp.trust_xheaders=True",
    "--ServerApp.allow_remote_access=True",
    "--ServerApp.trust_xheaders=True",
    "--IdentityProvider.token=''",
    f"--PasswordIdentityProvider.hashed_password='{password_hash}'",
])
lines = ["# Generated by configure-module. Do not edit by hand.", "JUPYTER_TOKEN=", f"NOTEBOOK_ARGS={notebook_args}"]
lines += [f"{k}={v}" for k, v in user.items()]
lines.append(f"AIIDALAB_DEFAULT_APPS={' '.join(apps)}")
with open("aiidalab.env.tmp", "w") as fp:
    fp.write("\n".join(lines) + "\n")
os.chmod("aiidalab.env.tmp", 0o600)
os.replace("aiidalab.env.tmp", "aiidalab.env")
