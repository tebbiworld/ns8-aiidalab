# Run `verdi computer test <label>` inside the container (SSH connection,
# scheduler, work directory) and return its output.

import json
import subprocess
import sys

import agent

data = json.load(sys.stdin)
label = data["label"]
try:
    proc = subprocess.run(["podman", "exec", "aiidalab-app", "bash", "-lc", f"verdi computer test {label} 2>&1"],
                          capture_output=True, text=True, timeout=180)
except subprocess.TimeoutExpired:
    print(agent.SD_ERR + "verdi computer test timed out", file=sys.stderr)
    sys.exit(1)
out = proc.stdout.strip()
# verdi computer test exits 0 even when a test fails; the report is authoritative
success = proc.returncode == 0 and "[FAILED]" not in out and "tests failed" not in out
json.dump({"success": success, "output": out[-4000:]}, fp=sys.stdout)
