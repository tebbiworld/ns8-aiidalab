{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "test-computer input",
    "$id": "http://nethserver.org/json-schema/task/input/aiidalab/test-computer",
    "description": "Run 'verdi computer test' for a registered computer",
    "examples": [{ "label": "gpu-node" }],
