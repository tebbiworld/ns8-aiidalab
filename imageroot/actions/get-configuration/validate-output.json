{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "get-configuration output",
    "$id": "http://schema.nethserver.org/aiidalab/get-configuration-output.json",
    "description": "Get AiiDAlab configuration",
    "type": "object",
    "properties": {
        "host": { "type": "string" },
        "http2https": { "type": "boolean" },
        "lets_encrypt": { "type": "boolean" },
        "password_set": { "type": "boolean" },
        "aiida_user_email": { "type": "string" },
        "aiida_user_first_name": { "type": "string" },
        "aiida_user_last_name": { "type": "string" },
        "aiida_user_institution": { "type": "string" },
        "default_apps": { "type": "array", "items": { "type": "string" } },
        "computer_enabled": { "type": "boolean" },
        "computer_label": { "type": "string" },
        "computer_hostname": { "type": "string" },
        "computer_username": { "type": "string" },
        "computer_port": { "type": "integer" },
        "computer_workdir": { "type": "string" },
        "computer_scheduler": { "type": "string" },
        "computer_mpirun": { "type": "string" },
        "computer_mpiprocs": { "type": "integer" },
        "computer_description": { "type": "string" },
        "url": { "type": "string" },
        "container_running": { "type": "boolean" },
        "app_up": { "type": "boolean" },
        "aiida_version": { "type": "string" },
        "aiidalab_version": { "type": "string" },
        "ssh_public_key": { "type": "string" },
        "computers": { "type": "array", "items": { "type": "string" } }
    }
}
